AKAMAI_BASE_URL=https://api.akamai-inference.com/v1
AKAMAI_API_KEY=
CHAT_MODEL=qwen3-8-27b
VISION_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=qwen3-embedding-8b

# Use a long, random value. An empty value disables the staff inventory endpoint.
DESK_PIN=

# Optional: the database role needs access to a PostgreSQL schema with pgvector.
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=defaultdb
PGSSLMODE=verify-full
PGSSLROOTCERT=
PGOPTIONS=

# Optional: use a private bucket and a bucket-scoped key.
OBJ_ENDPOINT=
OBJ_BUCKET=
OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=
